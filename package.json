{
  "name": "evee",
  "version": "0.3.0",
  "description": "Headless-friendly chat SDK + React components (Tailwind v4, shadcn tokens)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^27",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^5"
  }
}
